{
  "manifest_version": 3,
  "name": "GP Cookie Relay",
  "version": "1.3",
  "description": "Relays the GlobalProtect SAML cookie to the gateway VM; silent daily reauth and tunnel status.",
  "permissions": [
    "webRequest",
    "notifications",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://globalprotect.cedarville.edu/*",
    "http://prattle.forest-regulus.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GP Relay",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}