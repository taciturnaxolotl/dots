 void processConnection(ref<Store> store, FdSource && from, FdSink && to, TrustedFlag trusted, RecursiveFlag recursive)
 {
+    /* Never abandon a write to the client half-way. `TunnelLogger` writes
+       through this sink, and it is called from contexts that cannot cope with
+       an exception, such as `ignoreExceptionExceptInterrupt()` inside a
+       `ThreadPool` worker: the resulting `Interrupted` escapes the thread and
+       terminates the daemon. Logging must not check for interrupts, and a
+       partially written worker protocol message is unrecoverable anyway. */
+    to.allowInterrupts = false;
+
 #ifndef _WIN32 // TODO need graceful async exit support on Windows?
