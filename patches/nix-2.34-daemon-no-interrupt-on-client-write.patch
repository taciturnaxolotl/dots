+     * Interrupting a write leaves a partially written message behind, which
+     * is unrecoverable for framed protocols and for logging. Sinks carrying
+     * either should set this to `false`.
+     */
+    bool allowInterrupts = true;
 
     FdSink()
         : fd(INVALID_DESCRIPTOR)
